{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskAtTop",
  "version": "0.1.0",
  "identifier": "com.deskattop.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build:fast",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
          "label": "settings",
          "title": "DeskAtTop Settings",
          "url": "settings.html",
          "dataDirectory": "webview",

        "width": 960,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Desktop customization layer",
    "longDescription": "Launcher boxes, productivity widgets and live wallpapers layered onto the Windows desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
