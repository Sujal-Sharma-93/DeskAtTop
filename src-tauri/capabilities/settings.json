{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "Permissions for the DeskAtTop Studio window.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "store:default",
    "dialog:allow-open",
    "autostart:default",
    "allow-sync-box-window",
    "allow-sync-wallpaper-window",
    "allow-set-widgets-visible",
    "allow-sched-replace",
    "allow-ui-error",
    "allow-import-wallpaper-image",
    "allow-wallpaper-image",
    "allow-set-desktop-wallpaper"
  ]
}
